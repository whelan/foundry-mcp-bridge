# MCP server configuration. Copy to .env and fill in.
# This is the ONLY place connection config is read (no hardcoded strings).

# Required: WebSocket URL of the relay the Foundry module also connects to.
RELAY_URL=ws://localhost:8787

# Optional: shared secret. Must match the Foundry module's "Relay token" setting.
# RELAY_TOKEN=change-me

# Optional: per-command transport timeout in milliseconds (default 10000).
# RELAY_TIMEOUT_MS=10000
