# --- MCP server ---
FOUNDRY_RELAY_PORT=3010           # port the relay server listens on
FOUNDRY_RELAY_TOKEN=              # shared secret; set the SAME value in the Foundry module settings
MCP_TRANSPORT=stdio               # stdio (Claude Desktop) | sse

# --- Optional: only if the server itself uploads to The Forge without an open client ---
FORGE_API_KEY=                    # from forge-vtt.com -> API Key Manager (leave empty otherwise)
